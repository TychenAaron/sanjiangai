# 智能写作模型网关仅供服务端读取。默认 false 时始终使用本地模拟生成器，不会发起外部请求。
AI_MODEL_ENABLED=false
# 使用虚构示例地址和占位 Key；真实 Key 只能存入部署平台或本机受控密钥配置，绝不提交 Git。
AI_GATEWAY_BASE_URL=https://model-gateway.example.invalid/v1
AI_GATEWAY_API_KEY=replace-with-local-secret-only
# 可覆盖逻辑模型名 Qwen3.8-27B；后续本地部署只需修改地址和模型名，智能写作业务代码无需改变。
AI_WRITING_MODEL=Qwen3.8-27B
AI_MODEL_TIMEOUT_MS=15000
