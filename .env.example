# 智能写作模型网关仅供服务端读取。默认 false 时始终使用本地模拟生成器，不会发起外部请求。
AI_MODEL_ENABLED=false
# 使用虚构示例地址和占位 Key；真实 Key 只能存入部署平台或本机受控密钥配置，绝不提交 Git。
AI_GATEWAY_BASE_URL=https://model-gateway.example.invalid/v1
AI_GATEWAY_API_KEY=replace-with-local-secret-only
# 可覆盖逻辑模型名 Qwen3.8-27B；后续本地部署只需修改地址和模型名，智能写作业务代码无需改变。
AI_WRITING_MODEL=Qwen3.8-27B
AI_MODEL_TIMEOUT_MS=15000

# 正式资料向量索引仅由服务端读取。未配置时不生成模拟向量，资料仍可继续使用既有关键词检索。
# 后续切换本地 Qwen3-Embedding-4B 或合规模型服务时，只改网关地址与模型名，不修改 RAG 业务代码。
EMBEDDING_BASE_URL=https://embedding-gateway.example.invalid/v1
EMBEDDING_API_KEY=replace-with-server-secret-only
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_TIMEOUT_MS=15000

# Reranker 仅重排已经完成正式资料、D4、版本、可靠性和 ACL 过滤的候选。未配置或调用失败时安全沿用 Hybrid RRF 顺序；密钥只允许存在服务端安全变量。
RERANKER_BASE_URL=https://reranker-gateway.example.invalid/v1
RERANKER_API_KEY=replace-with-server-secret-only
RERANKER_MODEL=Qwen3-Reranker-4B
RERANKER_PATH=/rerank
RERANKER_TIMEOUT_MS=8000
# 集中限制送入重排的候选数量和最终可引用证据数量，避免在路由中写死数字。
RERANK_CANDIDATE_LIMIT=20
RERANK_TOP_K=5

# OA 同步默认关闭；地址和凭证只能配置在部署平台或本机受控服务端环境，绝不提交真实 OA 信息。
OA_SYNC_ENABLED=false
OA_BASE_URL=https://oa.example.invalid
OA_LIST_PATH=/api/documents
OA_DETAIL_PATH=/api/documents/{id}
OA_DOWNLOAD_PATH=/api/documents/{id}/download
OA_AUTH_TYPE=none
OA_ACCESS_TOKEN=replace-with-server-secret-only
OA_API_KEY=replace-with-server-secret-only
OA_REQUEST_TIMEOUT_MS=15000
# OA 管理后台配置中的凭证使用此服务端密钥加密后保存；仅部署平台/Worker binding 可设置，绝不下发浏览器。
OA_CONFIG_ENCRYPTION_KEY=replace-with-server-side-random-secret
